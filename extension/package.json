{
  "name": "verilog-visualizer-vscode",
  "displayName": "Verilog Visualizer",
  "description": "VS Code host shell for Verilog visualization and a digital-circuit sandbox (digitaljs simulation)",
  "version": "0.0.2",
  "publisher": "AH233",
  "license": "MIT",
  "icon": "./media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AH23333/verilog-visualizer"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "只读浏览、电路渲染与 Verilog 综合在不受信任工作区可用；写入或改动工作区文件（新建/重命名/删除/保存 .djs）需要受信任的工作区。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verilogVizCode",
          "title": "%vv.container.code%",
          "icon": "./media/code.svg"
        },
        {
          "id": "verilogVizSandbox",
          "title": "%vv.container.sandbox%",
          "icon": "./media/sandbox.svg"
        }
      ]
    },
    "views": {
      "verilogVizCode": [
        {
          "id": "verilogViz.codeFiles",
          "name": "%vv.view.codeFiles%",
          "type": "tree",
          "icon": "$(files)"
        },
        {
          "id": "verilogViz.modules",
          "name": "%vv.view.modules%"
        },
        {
          "id": "verilogViz.hierarchy",
          "name": "%vv.view.hierarchy%"
        }
      ],
      "verilogVizSandbox": [
        {
          "id": "verilogViz.sandboxFiles",
          "name": "%vv.view.sandboxFiles%",
          "type": "tree",
          "icon": "$(files)"
        },
        {
          "id": "verilogViz.sandboxParts",
          "name": "%vv.view.parts%"
        },
        {
          "id": "verilogViz.sandboxHierarchy",
          "name": "%vv.view.sandboxHierarchy%"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "verilogViz.doc",
        "displayName": "%vv.editor.canvas%",
        "selector": [
          {
            "filenamePattern": "*.djs"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "verilog",
        "extensions": [
          ".v",
          ".vh"
        ],
        "aliases": [
          "Verilog",
          "verilog"
        ]
      },
      {
        "id": "systemverilog",
        "extensions": [
          ".sv",
          ".svh"
        ],
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ]
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./grammars/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./grammars/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "verilogViz.compileAndShow",
        "title": "%vv.cmd.verilogViz.compileAndShow%",
        "category": "Verilog Visualizer",
        "icon": "./media/compile.svg"
      },
      {
        "command": "verilogViz.sim.togglePause",
        "title": "%vv.cmd.verilogViz.sim.togglePause%",
        "category": "Verilog Visualizer",
        "icon": "./media/pause.svg"
      },
      {
        "command": "verilogViz.sim.stepOnce",
        "title": "%vv.cmd.verilogViz.sim.stepOnce%",
        "category": "Verilog Visualizer",
        "icon": "./media/step.svg"
      },
      {
        "command": "verilogViz.exportSvg",
        "title": "%vv.cmd.verilogViz.exportSvg%",
        "category": "Verilog Visualizer",
        "icon": "./media/export.svg"
      },
      {
        "command": "verilogViz.newVerilogFile",
        "title": "%vv.cmd.verilogViz.newVerilogFile%",
        "category": "Verilog Visualizer",
        "icon": "$(new-file)"
      },
      {
        "command": "verilogViz.newSandboxFile",
        "title": "%vv.cmd.verilogViz.newSandboxFile%",
        "category": "Verilog Visualizer",
        "icon": "$(new-file)"
      },
      {
        "command": "verilogViz.newSandboxFolder",
        "title": "%vv.cmd.verilogViz.newSandboxFolder%",
        "category": "Verilog Visualizer",
        "icon": "$(new-folder)"
      },
      {
        "command": "verilogViz.openExamples",
        "title": "%vv.cmd.verilogViz.openExamples%",
        "category": "Verilog Visualizer"
      },
      {
        "command": "verilogVisualizer.refreshTrees",
        "title": "%vv.cmd.verilogVisualizer.refreshTrees%",
        "category": "Verilog Visualizer",
        "icon": "$(refresh)"
      },
      {
        "command": "verilogVisualizer.revealProjectDir",
        "title": "%vv.cmd.verilogVisualizer.revealProjectDir%",
        "category": "Verilog Visualizer"
      },
      {
        "command": "verilogViz.openDoc",
        "title": "%vv.cmd.verilogViz.openDoc%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.renameFile",
        "title": "%vv.cmd.verilogViz.renameFile%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.deleteFile",
        "title": "%vv.cmd.verilogViz.deleteFile%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.duplicateFile",
        "title": "%vv.cmd.verilogViz.duplicateFile%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.togglePartRole",
        "title": "%vv.cmd.verilogViz.togglePartRole%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.bindParts",
        "title": "%vv.cmd.verilogViz.bindParts%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openModuleAt",
        "title": "%vv.cmd.verilogViz.openModuleAt%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openModuleItem",
        "title": "%vv.cmd.verilogViz.openModuleItem%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openFile",
        "title": "%vv.cmd.verilogViz.openFile%",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openBindingConfig",
        "title": "%vv.cmd.verilogViz.openBindingConfig%",
        "icon": "$(json)"
      },
      {
        "command": "verilogViz.materializeBindings",
        "title": "%vv.cmd.verilogViz.materializeBindings%",
        "icon": "$(lock)"
      },
      {
        "command": "verilogViz.duplicateFolder",
        "title": "%vv.cmd.verilogViz.duplicateFolder%",
        "icon": "$(files)"
      },
      {
        "command": "verilogViz.importFiles",
        "title": "%vv.cmd.verilogViz.importFiles%",
        "icon": "$(desktop-download)"
      },
      {
        "command": "verilogViz.importVerilogFiles",
        "title": "%vv.cmd.verilogViz.importVerilogFiles%",
        "icon": "$(desktop-download)"
      },
      {
        "command": "verilogViz.importSandboxFiles",
        "title": "%vv.cmd.verilogViz.importSandboxFiles%",
        "icon": "$(desktop-download)"
      },
      {
        "command": "verilogViz.moveTo",
        "title": "%vv.cmd.verilogViz.moveTo%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "verilogViz.copyPath",
        "title": "%vv.cmd.verilogViz.copyPath%"
      },
      {
        "command": "verilogViz.revealInOS",
        "title": "%vv.cmd.verilogViz.revealInOS%"
      },
      {
        "command": "verilogViz.auditBindings",
        "title": "%vv.cmd.verilogViz.auditBindings%",
        "icon": "$(search)"
      },
      {
        "command": "verilogViz.completeBindings",
        "title": "%vv.cmd.verilogViz.completeBindings%",
        "icon": "$(checklist)"
      },
      {
        "command": "verilogViz.initProject",
        "title": "%vv.cmd.verilogViz.initProject%",
        "icon": "$(root-folder)"
      }
    ],
    "menus": {
