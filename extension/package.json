          "command": "verilogVisualizer.refreshTrees",
          "when": "view == verilogViz.modules",
          "group": "navigation@8"
        },
        {
          "command": "verilogVisualizer.refreshTrees",
          "when": "view == verilogViz.hierarchy",
          "group": "navigation@8"
        },
        {
          "command": "verilogVisualizer.refreshTrees",
          "when": "view == verilogViz.sandboxFiles",
          "group": "navigation@8"
        },
        {
          "command": "verilogVisualizer.refreshTrees",
          "when": "view == verilogViz.sandboxParts",
          "group": "navigation@8"
        },
        {
          "command": "verilogVisualizer.refreshTrees",
          "when": "view == verilogViz.sandboxHierarchy",
          "group": "navigation@8"
        },
        {
          "command": "verilogViz.newSandboxFolder",
          "when": "view == verilogViz.codeFiles",
          "group": "navigation@2"
        },
        {
          "command": "verilogViz.importVerilogFiles",
          "when": "view == verilogViz.codeFiles",
          "group": "navigation@3"
        },
        {
          "command": "verilogViz.importSandboxFiles",
          "when": "view == verilogViz.sandboxFiles",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "verilogViz.openModuleAt",
          "when": "false"
        },
        {
          "command": "verilogViz.openModuleItem",
          "when": "false"
        },
        {
          "command": "verilogViz.openFile",
          "when": "false"
        },
        {
          "command": "verilogViz.openDoc",
          "when": "false"
        },
        {
          "command": "verilogViz.renameFile",
          "when": "false"
        },
        {
          "command": "verilogViz.deleteFile",
          "when": "false"
        },
        {
          "command": "verilogViz.duplicateFile",
          "when": "false"
        },
        {
          "command": "verilogViz.togglePartRole",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "verilogViz.compileAndShow",
        "key": "ctrl+f5",
        "when": "resourceExtname =~ /\\.(v|sv|vh)$/"
      },
      {
        "command": "verilogViz.sim.stepOnce",
        "key": "f7",
        "when": "activeWebviewPanelId == 'verilogVisualizer' || activeCustomEditorId == 'verilogViz.doc'"
      }
    ],
    "configuration": {
      "title": "Verilog Visualizer",
      "properties": {
        "verilogViz.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%vv.config.verilogViz.language%",
          "enumItemLabels": [
            "%vv.config.verilogViz.language.label0%",
            "%vv.config.verilogViz.language.label1%",
            "%vv.config.verilogViz.language.label2%"
          ]
        },
        "verilogViz.compile.topModule": {
          "type": "string",
          "default": "",
          "markdownDescription": "%vv.config.verilogViz.compile.topModule%"
        },
        "verilogViz.compile.yosysOptions": {
          "type": "string",
          "default": "",
          "markdownDescription": "%vv.config.verilogViz.compile.yosysOptions%"
        },
        "verilogViz.compile.noFlatten": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%vv.config.verilogViz.compile.noFlatten%"
        },
        "verilogViz.compile.noOpt": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%vv.config.verilogViz.compile.noOpt%"
        },
        "verilogViz.compile.autoRecompile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%vv.config.verilogViz.compile.autoRecompile%"
        },
        "verilogViz.sandbox.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "maximum": 64,
          "markdownDescription": "%vv.config.verilogViz.sandbox.gridSize%"
        },
        "verilogViz.sandbox.showGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%vv.config.verilogViz.sandbox.showGrid%"
        },
        "verilogViz.sandbox.snapToGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%vv.config.verilogViz.sandbox.snapToGrid%"
        },
        "verilogViz.sandbox.wireStyle": {
          "type": "string",
          "enum": [
            "metro",
            "orthogonal",
            "straight"
          ],
          "default": "metro",
          "markdownDescription": "%vv.config.verilogViz.sandbox.wireStyle%"
        },
        "verilogViz.sandbox.defaultBits": {
          "type": "number",
          "default": 1,
          "enum": [
            1,
            2,
            4,
            8,
            16
          ],
          "markdownDescription": "%vv.config.verilogViz.sandbox.defaultBits%"
        },
        "verilogViz.sandbox.autoStartSim": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%vv.config.verilogViz.sandbox.autoStartSim%"
        },
        "verilogViz.sandbox.simSpeedMs": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 200,
          "markdownDescription": "%vv.config.verilogViz.sandbox.simSpeedMs%"
        },
        "verilogViz.sandbox.foldConstants": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%vv.config.verilogViz.sandbox.foldConstants%"
        },
        "verilogViz.bindings.policy": {
          "type": "string",
          "enum": [
            "auto",
            "strict"
          ],
          "default": "auto",
          "markdownDescription": "%vv.config.verilogViz.bindings.policy%",
          "enumItemLabels": [
            "%vv.config.verilogViz.bindings.policy.label0%",
            "%vv.config.verilogViz.bindings.policy.label1%"
          ]
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "verilogViz.codeFiles",
        "contents": "%vv.welcome.code%"
      },
      {
        "view": "verilogViz.sandboxFiles",
        "contents": "%vv.welcome.sandbox%"
      },
      {
        "view": "verilogViz.hierarchy",
        "contents": "%vv.welcome.modules%"
      },
      {
        "view": "verilogViz.sandboxHierarchy",
        "contents": "%vv.welcome.parts%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.verilogviz.json",
        "url": "./schemas/vv-bind.schema.json"
      },
      {
        "fileMatch": "**/.vv/api.json",
        "url": "./schemas/vv-api.schema.json"
      },
      {
        "fileMatch": "**/.vv/api.grants.json",
        "url": "./schemas/vv-grants.schema.json"
      },
      {
        "fileMatch": "**/.vv/project.json",
        "url": "./schemas/vv-project.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "node esbuild.js --production && vsce package --no-dependencies",
    "webview:sync": "node sync-webview.js",
    "check": "tsc -p ./ --noEmit && node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3"
  }
}
