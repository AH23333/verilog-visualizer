{
  "name": "verilog-visualizer-vscode",
  "displayName": "Verilog Visualizer",
  "description": "Verilog 可视化与数字电路沙盒（digitaljs 仿真）在 VS Code 内的宿主壳",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "本扩展不起子进程、不执行工作区里带来的可执行文件：Yosys/DigitalJS 是打进包里的 WASM，工作区内容只当文本读、当图渲染（前端两处 innerHTML 都只赋空串，webview 那份 CSP 的 script-src 只有 nonce + webview origin）。少了这一句，在一个从没信任过的新文件夹里宿主根本不会被激活——症状是启动后只剩一颗 Welcome（受限模式）页，不报错、日志里也一行都没有。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "verilogVisualizer.open",
        "title": "打开 Verilog 可视化窗口",
        "category": "Verilog Visualizer"
      },
      {
        "command": "verilogVisualizer.revealProjectDir",
        "title": "打开项目文件所在文件夹（落盘核对用）",
        "category": "Verilog Visualizer"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "node esbuild.js --production && vsce package --no-dependencies",
    "webview:sync": "node sync-webview.js",
    "check": "tsc -p ./ --noEmit && node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3"
  }
}
