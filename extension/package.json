        "category": "Verilog Visualizer"
      },
      {
        "command": "verilogViz.openDoc",
        "title": "打开电路画布",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.renameFile",
        "title": "重命名",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.deleteFile",
        "title": "删除",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.duplicateFile",
        "title": "创建副本",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.togglePartRole",
        "title": "切换部件角色",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.bindParts",
        "title": "部件绑定",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openModuleAt",
        "title": "打开模块定义",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openModuleItem",
        "title": "打开定义",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openFile",
        "title": "打开定义文件",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openBindingConfig",
        "title": "打开部件绑定配置…",
        "icon": "$(json)"
      },
      {
        "command": "verilogViz.materializeBindings",
