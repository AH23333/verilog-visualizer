{
  "name": "verilog-visualizer-vscode",
  "displayName": "Verilog Visualizer",
  "description": "Verilog 可视化与数字电路沙盒（digitaljs 仿真）在 VS Code 内的宿主壳",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "本扩展不起子进程、不执行工作区里带来的可执行文件：Yosys/DigitalJS 是打进包里的 WASM，工作区内容只当文本读、当图渲染（前端两处 innerHTML 都只赋空串，webview 那份 CSP 的 script-src 只有 nonce + webview origin）。少了这一句，在一个从没信任过的新文件夹里宿主根本不会被激活——症状是启动后只剩一颗 Welcome（受限模式）页，不报错、日志里也一行都没有。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verilogVizCode",
          "title": "代码编译",
          "icon": "./media/code.svg"
        },
        {
          "id": "verilogVizSandbox",
          "title": "沙盒编辑",
          "icon": "./media/sandbox.svg"
        }
      ]
    },
    "views": {
      "verilogVizCode": [
        {
          "id": "verilogViz.codeFiles",
          "name": "文件",
          "type": "webview",
          "icon": "$(files)"
        },
        {
          "id": "verilogViz.modules",
          "name": "模块 Modules"
        },
        {
          "id": "verilogViz.hierarchy",
          "name": "层次结构 Hierarchy"
        }
      ],
      "verilogVizSandbox": [
        {
          "id": "verilogViz.sandboxFiles",
          "name": "文件",
          "type": "webview",
          "icon": "$(files)"
        },
        {
          "id": "verilogViz.sandboxParts",
          "name": "部件 Parts"
        },
        {
          "id": "verilogViz.sandboxHierarchy",
          "name": "层次结构 Hierarchy"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "verilogViz.doc",
        "displayName": "电路画布",
        "selector": [
          {
            "filenamePattern": "*.djs"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "verilog",
        "extensions": [
          ".v",
          ".vh"
        ],
        "aliases": [
          "Verilog",
          "verilog"
        ]
      },
      {
        "id": "systemverilog",
        "extensions": [
          ".sv",
          ".svh"
        ],
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ]
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./grammars/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./grammars/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "verilogViz.compileAndShow",
        "title": "编译并查看电路",
        "category": "Verilog Visualizer",
        "icon": "./media/compile.svg"
      },
      {
        "command": "verilogViz.sim.togglePause",
        "title": "暂停/继续仿真",
        "category": "Verilog Visualizer",
        "icon": "./media/pause.svg"
      },
      {
        "command": "verilogViz.sim.stepOnce",
        "title": "单步仿真",
        "category": "Verilog Visualizer",
        "icon": "./media/step.svg"
      },
      {
        "command": "verilogViz.exportSvg",
        "title": "导出电路为 SVG",
        "category": "Verilog Visualizer",
        "icon": "./media/export.svg"
      },
      {
        "command": "verilogViz.newVerilogFile",
        "title": "新建 Verilog 文件",
        "category": "Verilog Visualizer",
        "icon": "$(new-file)"
      },
      {
        "command": "verilogViz.newSandboxFile",
        "title": "新建沙盒电路",
        "category": "Verilog Visualizer",
        "icon": "$(new-file)"
      },
      {
        "command": "verilogViz.newSandboxFolder",
