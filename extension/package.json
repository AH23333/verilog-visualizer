        {
          "command": "verilogViz.importFiles",
          "when": "webviewId == 'verilogViz.sandboxFiles' && vvKind == 'dir'",
          "group": "1_new@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "verilogViz.compileAndShow",
        "key": "ctrl+f5",
        "when": "resourceExtname =~ /\\.(v|sv)$/"
      },
      {
        "command": "verilogViz.sim.stepOnce",
        "key": "f7",
        "when": "activeWebviewPanelId == 'verilogVisualizer' || activeCustomEditorId == 'verilogViz.doc'"
      }
    ],
    "configuration": {
      "title": "Verilog Visualizer",
      "properties": {
        "verilogViz.compile.topModule": {
          "type": "string",
          "default": "",
          "markdownDescription": "编译的顶层模块名。留空则用入口文件里定义的第一个模块。"
        },
        "verilogViz.compile.yosysOptions": {
          "type": "string",
          "default": "",
          "markdownDescription": "附加给 yosys 的选项（空格分隔）。"
        },
        "verilogViz.compile.noFlatten": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "⛔ 展平层次（保留模块边界）。"
        },
        "verilogViz.compile.noOpt": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "⛔ 优化（保留原始门结构）。"
        },
        "verilogViz.compile.autoRecompile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "保存 `.v` 文件时自动重新编译并刷新画布（画布面板开着时）。"
        },
        "verilogViz.sandbox.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "maximum": 64,
          "markdownDescription": "沙盒画布网格间距（px）。"
        },
        "verilogViz.sandbox.showGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "沙盒画布显示网格。"
        },
        "verilogViz.sandbox.snapToGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "拖动部件时吸附到网格。"
        },
        "verilogViz.sandbox.wireStyle": {
          "type": "string",
          "enum": [
            "metro",
            "orthogonal",
            "straight"
          ],
          "default": "metro",
          "markdownDescription": "连线走线方式。"
        },
        "verilogViz.sandbox.defaultBits": {
          "type": "number",
          "default": 1,
          "enum": [
            1,
            2,
            4,
            8,
            16
          ],
          "markdownDescription": "新建 IO 部件的默认位宽。"
        },
        "verilogViz.sandbox.autoStartSim": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "打开沙盒时自动运行仿真。"
        },
        "verilogViz.sandbox.simSpeedMs": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 200,
          "markdownDescription": "仿真步进间隔（ms）。"
        },
        "verilogViz.sandbox.foldConstants": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "只读视图把「运算器 + Constant 喂入」折叠成圆圈。"
        },
        "verilogViz.bindings.policy": {
          "type": "string",
          "enum": [
            "auto",
            "strict"
          ],
          "default": "auto",
          "markdownDescription": "部件绑定完整度策略：**auto**＝未录入的实例靠同名兜底解析，并可见提示\"一键写全\"；**strict**＝必须录全——没录入配置的子部件实例⛔ 同名兜底（编译报错、画布不展开，右键「写全绑定配置」一键补齐后恢复）。",
          "enumItemLabels": [
            "自动兜底（提示写全）",
            "严格（必须配全）"
          ]
        }
      }
    },
    "viewsWelcome": {
      "verilogViz.codeFiles": "工作区还没有 `.v/.sv` 文件。\n[新建 Verilog 文件](command:verilogViz.newVerilogFile)\n[导入文件…](command:verilogViz.importFiles)\n也可以在资源管理器里放一个 `.v`，回来直接 `Ctrl+F5` 编译。",
      "verilogViz.sandboxFiles": "还没有电路文档（`.djs`）。\n[新建电路](command:verilogViz.newSandboxFile)\n[新建文件夹](command:verilogViz.newSandboxFolder)\n[导入文件…](command:verilogViz.importFiles)\n[打开示例电路](command:verilogViz.openExamples)",
      "verilogViz.hierarchy": "打开一个 `.v / .sv` 文件后，这里按**例化关系**展开模块层次。",
      "verilogViz.sandboxHierarchy": "打开一个 `.djs` 电路文档后，这里列出它的子电路实例（右键直达部件绑定）。"
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.verilogviz.json",
        "url": "./schemas/vv-bind.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "node esbuild.js --production && vsce package --no-dependencies",
    "webview:sync": "node sync-webview.js",
    "check": "tsc -p ./ --noEmit && node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3"
  }
}
