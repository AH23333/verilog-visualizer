{
  "name": "verilog-visualizer-vscode",
  "displayName": "Verilog Visualizer",
  "description": "Verilog 编译 + 可交互电路图 + 逻辑沙盒（VS Code 扩展形态）。Compile Verilog, explore circuits interactively, and design in a logic sandbox.",
  "version": "0.1.0",
  "publisher": "ah",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verilogViz",
          "title": "Verilog Viz / 电路可视化",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "verilogViz": [
        {
          "id": "verilogViz.modules",
          "name": "模块 Modules",
          "when": "verilogViz.hasWorkspace"
        },
        {
          "id": "verilogViz.hierarchy",
          "name": "层次结构 Hierarchy",
          "when": "verilogViz.hasWorkspace"
        },
        {
          "id": "verilogViz.sandbox",
          "name": "沙盒 Sandbox",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "verilogViz.compile",
        "title": "编译当前文件 / Compile",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.openSandbox",
        "title": "打开沙盒 / Open Sandbox",
        "category": "Verilog Viz"
      },
      {
        "command": "verilogViz.refreshTrees",
        "title": "刷新模块树 / Refresh Trees",
        "category": "Verilog Viz"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "verilogViz.compile",
          "when": "resourceExtname == .v",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Verilog Viz",
      "properties": {
        "verilogViz.sandboxDir": {
          "type": "string",
          "default": "sandbox",
          "description": "沙盒文件目录（相对工作区根）/ Sandbox folder relative to workspace root"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.140.0",
    "typescript": "~5.8.3"
  }
}
