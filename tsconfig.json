{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Error：Error 的 cause 选项（subcircuitView 降级弹窗保留原始栈，preserve-caught-error）
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* 测试里 `import * as vscode from 'vscode'` 指的是那颗无头桩（运行时同名的 alias 在 vitest.config.ts）。
       ⛔ 只配这里的一半：那样 tsc 过、跑起来找不到模块。 */
    "paths": { "vscode": ["./tests/unit/vscodeApiStub.ts"] },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests/unit"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
