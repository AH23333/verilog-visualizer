{
  "name": "verilog-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "app": "node scripts/run-in-vscode.mjs",
    "app:check": "node scripts/run-in-vscode.mjs --check",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "ext:build": "pnpm -C extension build",
    "ext:watch": "pnpm -C extension watch",
    "ext:check": "pnpm -C extension check",
    "ext:package": "pnpm build && pnpm -C extension webview:sync && pnpm -C extension package",
    "studio:brand": "node studio/apply-brand.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/state": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@codemirror/view": "^6",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "digitaljs": "^0.14.2",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "yosys": "^0.30.5",
    "yosys2digitaljs": "^0.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  }
}
